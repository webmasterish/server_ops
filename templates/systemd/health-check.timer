[Unit]
Description=Daily machine health check

[Timer]
# 07:15 UTC. Deliberately downstream of everything it inspects: the backup
# starts 03:15 (+15m jitter, ~12min run), the Sunday repo check starts 05:00,
# logrotate runs 00:00. Checking in the morning means a failure in any of them
# is reported the same day rather than a day late.
#
# Not 06:30, which it was until 2026-10-22: apt-daily-upgrade.timer fires at
# 06:00 + up to 60m, and unattended-upgrades restarts services (needrestart)
# after library updates. That morning a liblzma5 update restarted redis in the
# same two seconds the check looked at it -- a false FAIL for redis and for the
# R2 snapshot read. 07:15 clears the whole apt window.
OnCalendar=*-*-* 07:15:00

# Small: unlike the backup there is no object-store thundering herd to avoid,
# and a tighter window keeps the report time predictable.
RandomizedDelaySec=5m

# If the box was down at 07:15, check on the next boot. A machine that just
# came back up is exactly when you want the check to run.
Persistent=true

[Install]
WantedBy=timers.target
