[Unit]
Description=Offsite backup (databases + sites + /etc) to Cloudflare R2
Documentation=file:///home/webmasterish/server_ops/docs/runbook-backups.md
# Dumps need the database up. Wants= not Requires=: if mysql is down we still
# want the attempt and a loud failure, not a silently skipped night.
Wants=network-online.target mysql.service
After=network-online.target mysql.service

[Service]
Type=oneshot
User=root

# Holds RESTIC_REPOSITORY, RESTIC_PASSWORD_FILE and the R2 keys. 0600 root.
# Not in the repo -- see docs/runbook-backups.md.
EnvironmentFile=/etc/restic/restic.env

ExecStart=/home/webmasterish/server_ops/scripts/restic-backup.sh

# Backups are not worth an outage. Below-normal CPU and idle IO keep the run
# off the critical path for the sites; ayatalquran.com serves real traffic and
# menamaps.com takes orders while this is running.
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=batch

# A stuck network call should not leave a lock held until someone notices.
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
